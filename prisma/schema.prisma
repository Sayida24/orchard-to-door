generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum BatchStatus {
  OPEN
  SOLD_OUT
  CLOSED
}

enum OrderStatus {
  PLACED // waiting for the seller to approve (the kg are held)
  APPROVED // the seller accepted it
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  BKASH
  NAGAD
  CARD
}

enum AiStatus {
  PENDING
  CLEAN
  DEFECT_FOUND
}

enum ComplaintStatus {
  OPEN
  APPROVED
  REJECTED
}

// What the admin approved for a complaint (FR-21, FR-25)
enum ComplaintResolution {
  REPLACEMENT
  REFUND
}

model User {
  id                  String               @id @default(cuid())
  name                String
  phone               String               @unique
  email               String?              @unique
  passwordHash        String
  role                Role                 @default(CUSTOMER)
  createdAt           DateTime             @default(now())
  // Set on every password change; sessions issued before it are logged out
  passwordChangedAt   DateTime?
  orchards            Orchard[]            @relation("SellerOrchards")
  batches             Batch[]              @relation("SellerBatches")
  orders              Order[]              @relation("CustomerOrders")
  complaints          Complaint[]
  notifications       Notification[]
  reviews             Review[]
  passwordResetTokens PasswordResetToken[] @relation("ResetTokenUser")
  createdResetTokens  PasswordResetToken[] @relation("ResetTokenCreator")
  addedVarieties      Variety[]            @relation("VarietyAddedBy")
}

// One-time password reset link. Only a SHA-256 hash of the token is stored,
// so a database leak can't be used to reset passwords.
model PasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation("ResetTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  // Set when an admin created the link; null for self-service email reset
  createdById String?
  createdBy   User?     @relation("ResetTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Orchard {
  id          String         @id @default(cuid())
  name        String
  location    String
  description String?
  videoUrl    String?
  photoUrls   String[]
  // false = paused by an admin: hidden from customers, no new orders
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  sellerId    String
  seller      User           @relation("SellerOrchards", fields: [sellerId], references: [id])
  batches     Batch[]
  videos      HarvestVideo[]
  reviews     Review[]
}

model Variety {
  id          String   @id @default(cuid())
  name        String   @unique
  seasonStart Int?
  seasonEnd   Int?
  taste       String?
  bestUse     String?
  createdAt   DateTime @default(now())
  // Sellers add varieties when listing a batch; null for the sample varieties
  addedById   String?
  addedBy     User?    @relation("VarietyAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  batches     Batch[]
}

model Batch {
  id              String         @id @default(cuid())
  harvestDate     DateTime
  totalKg         Float
  availableKg     Float
  pricePerKg      Float
  harvestVideoUrl String?
  spinImageUrls   String[]
  status          BatchStatus    @default(OPEN)
  closesAt        DateTime?
  createdAt       DateTime       @default(now())
  orchardId       String
  orchard         Orchard        @relation(fields: [orchardId], references: [id])
  varietyId       String
  variety         Variety        @relation(fields: [varietyId], references: [id])
  sellerId        String
  seller          User           @relation("SellerBatches", fields: [sellerId], references: [id])
  orders          Order[]
  videos          HarvestVideo[]
}

model Order {
  id             String        @id @default(cuid())
  quantityKg     Int // any amount the customer wants, in whole kg
  pricePerKg     Float // the seller's price when the order was placed
  isGiftBox      Boolean       @default(false)
  giftFee        Float         @default(0)
  totalPrice     Float
  deliveryFee    Float         @default(0)
  address        String // house, flat and road (the area is deliveryArea)
  landmark       String?
  deliverySlot   String?
  deliveryAreaId String?
  deliveryArea   DeliveryArea? @relation(fields: [deliveryAreaId], references: [id])
  paymentMethod  PaymentMethod @default(CASH_ON_DELIVERY)
  status         OrderStatus   @default(PLACED)
  createdAt      DateTime      @default(now())
  approvedAt     DateTime? // the seller approves within 24 hours, or the order is cancelled
  packedAt       DateTime?
  dispatchedAt   DateTime?
  deliveredAt    DateTime? // set when the customer confirms (or the seller, 2 days after dispatch)
  cancelledAt    DateTime?
  cancelReason   String? // seller (before packing), customer (before approval) or the 24-hour rule
  customerId     String
  customer       User          @relation("CustomerOrders", fields: [customerId], references: [id])
  batchId        String
  batch          Batch         @relation(fields: [batchId], references: [id])
  boxes          Box[] // a big order is packed in several boxes
  complaints     Complaint[]
  review         Review?

  @@index([status, createdAt]) // finds orders waiting longer than 24 hours
}

model Box {
  id                 String    @id @default(cuid())
  qrCode             String    @unique
  photoUrls          String[]
  model3dUrl         String?
  weightKg           Float?
  scanCount          Int       @default(0)
  createdAt          DateTime  @default(now()) // QR label printed
  packedAt           DateTime? // set when the label is linked to an order
  aiStatus           AiStatus  @default(PENDING)
  aiHealthyCount     Int?
  aiDefectCount      Int?
  aiDetections       Json?
  annotatedPhotoUrls String[]
  aiCheckedAt        DateTime?
  // Optional so QR labels can be pre-printed; the seller scans one at packing (FR-17)
  orderId            String?
  order              Order?    @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Complaint {
  id          String               @id @default(cuid())
  reason      String? // e.g. "Damaged or bruised"
  message     String
  photoUrls   String[]
  status      ComplaintStatus      @default(OPEN)
  resolution  ComplaintResolution?
  adminNote   String?
  resolvedAt  DateTime?
  // When the seller finished an approved refund or replacement
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  orderId     String
  order       Order                @relation(fields: [orderId], references: [id])
  customerId  String
  customer    User                 @relation(fields: [customerId], references: [id])
}

// FR-37: a customer rates a delivered order once (1–5 stars).
model Review {
  id         String   @id @default(cuid())
  rating     Int // 1 to 5
  comment    String?
  createdAt  DateTime @default(now())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orchardId  String
  orchard    Orchard  @relation(fields: [orchardId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])

  @@index([orchardId, createdAt])
}

// Harvest videos a seller uploads (FR-05/FR-07). The file lives in storage,
// compressed; this row is the small record describing it.
model HarvestVideo {
  id          String   @id @default(cuid())
  url         String // compressed video file in storage
  posterUrl   String? // still image shown before the video loads
  title       String?
  durationSec Int?
  sizeBytes   Int?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  orchardId   String
  orchard     Orchard  @relation(fields: [orchardId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([orchardId, recordedAt])
}

// Delivery charge by area (FR-10); Dhaka zones first
model DeliveryArea {
  id       String  @id @default(cuid())
  name     String  @unique
  fee      Float
  isActive Boolean @default(true)
  orders   Order[]
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}
